# Copy to .env and adjust. Defaults match docker-compose service names.
PG_DSN=postgresql://parallax:CHANGE_ME@localhost:5432/parallax
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=CHANGE_ME
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3
TRAINING_WINDOW_DAYS=30

# API keys (required; the API fails closed without them)
API_KEY_ADMIN=
API_KEY_INGEST=
API_KEY_ANALYST=
CORS_ORIGINS=http://localhost:3000
INGEST_ROOT=/data
